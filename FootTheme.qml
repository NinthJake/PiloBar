pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

// Styles the foot terminal to match the active theme. foot reads its config at
// startup, so this writes a generated ~/.config/foot/colors.ini (included from
// foot.ini's [main]) and sends running instances SIGUSR1 to reload it.
//
// foot only has a 16-colour ANSI palette, so the bar's tokens are mapped:
// black=line, red=error, green=plus, yellow=warning, blue=steel, magenta=accent
// (teal), cyan=a lightened steel, white=fg, with the brights lightened and
// muted for bright-black. Selection and cursor follow the accent.
Singleton {
    id: root

    readonly property string path: String(Quickshell.env("HOME")) + "/.config/foot/colors.ini"

    function apply() {
        const theme = Themes.find(Settings.theme)
        // Write then reload running foots in one shell command (SIGUSR1 makes
        // foot re-read its config). `|| true` so a session with no foot open is
        // not treated as an error.
        const script = "cat > '" + path + "' <<'PILO_EOF'\n" + buildIni(theme) + "PILO_EOF\n"
            + "pkill -USR1 -x foot || true"
        applyProc.command = ["sh", "-c", script]
        applyProc.running = true
    }

    function hex(c) {
        return c.charAt(0) === "#" ? c.substring(1) : c
    }

    function parse(h) {
        const c = h.charAt(0) === "#" ? h.substring(1) : h
        return {
            r: parseInt(c.substring(0, 2), 16),
            g: parseInt(c.substring(2, 4), 16),
            b: parseInt(c.substring(4, 6), 16)
        }
    }

    function pad(n) {
        const s = n.toString(16)
        return s.length < 2 ? "0" + s : s
    }

    function lighten(c, amount) {
        const a = parse(c)
        return pad(Math.round(a.r + (255 - a.r) * amount))
            + pad(Math.round(a.g + (255 - a.g) * amount))
            + pad(Math.round(a.b + (255 - a.b) * amount))
    }

    function buildIni(theme) {
        const bg = hex(theme.bg)
        const fg = hex(theme.fg)
        let s = ""
        s += "# Generated by the pilo bar (Theming). Do not edit; pick a theme there.\n"
        s += "# foot.ini includes this file from its [main] section.\n\n"
        s += "[colors-dark]\n"
        s += "background=" + bg + "\n"
        s += "foreground=" + fg + "\n"
        s += "regular0=" + hex(theme.line) + "\n"
        s += "regular1=" + hex(theme.error) + "\n"
        s += "regular2=" + hex(theme.plus) + "\n"
        s += "regular3=" + hex(theme.warning) + "\n"
        s += "regular4=" + hex(theme.steel) + "\n"
        s += "regular5=" + hex(theme.teal) + "\n"
        s += "regular6=" + lighten(theme.steel, 0.25) + "\n"
        s += "regular7=" + fg + "\n"
        s += "bright0=" + hex(theme.muted) + "\n"
        s += "bright1=" + lighten(theme.error, 0.25) + "\n"
        s += "bright2=" + lighten(theme.plus, 0.25) + "\n"
        s += "bright3=" + lighten(theme.warning, 0.25) + "\n"
        s += "bright4=" + lighten(theme.steel, 0.30) + "\n"
        s += "bright5=" + lighten(theme.teal, 0.25) + "\n"
        s += "bright6=" + lighten(theme.steel, 0.45) + "\n"
        s += "bright7=" + lighten(theme.fg, 0.30) + "\n"
        s += "selection-foreground=" + bg + "\n"
        s += "selection-background=" + hex(theme.teal) + "\n"
        // cursor takes two colours: text colour under the cursor, then the
        // cursor (block) colour itself.
        s += "cursor=" + bg + " " + hex(theme.teal) + "\n"
        return s
    }

    Connections {
        target: Settings
        function onThemeChanged() { root.apply() }
    }

    Process {
        id: applyProc
    }
}
