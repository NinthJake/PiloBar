pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

// Owns Hyprland's "Look and feel" block. hyprland.lua loads
// ~/.config/hypr/lookandfeel.lua (generated, gitignored) with require(); this
// singleton writes that file from the look-and-feel settings (gaps, border
// size, rounding, blur) plus the active theme's colours, and live-applies them
// so a change is instant. A reload would also work but re-runs the autostart
// block, so live application is preferred (the file is only for the next login).
//
// Live application uses `hyprctl eval` with a Lua hl.config call: Hyprland 0.56
// rejects `hyprctl keyword` for these options ("keyword can't work with
// non-legacy parsers. Use eval.").
//
// Editing the generated file by hand is pointless: any change (or a shell
// start) rewrites it.
Singleton {
    id: root

    readonly property string path: String(Quickshell.env("HOME")) + "/.config/hypr/lookandfeel.lua"

    // Border gradient / inactive border alphas, matching the original values
    // (rgba, so the suffix is the alpha).
    readonly property string activeAlpha: "ee"
    readonly property string inactiveAlpha: "aa"
    readonly property int activeAngle: 45

    function hex(c) {
        return c.charAt(0) === "#" ? c.substring(1) : c
    }

    function luaBool(v) {
        return v ? "true" : "false"
    }

    // The Hyprland colour set for a theme, derived from its palette so every
    // theme (including future ones) themes the compositor consistently.
    function hyprFor(theme) {
        return {
            active: ["rgba(" + hex(theme.teal) + activeAlpha + ")", "rgba(" + hex(theme.steel) + activeAlpha + ")"],
            inactive: "rgba(" + hex(theme.muted) + inactiveAlpha + ")",
            background: "0x" + hex(theme.hyprBackground || theme.bg)
        }
    }

    // Regenerate the include and apply everything live. Called on shell start
    // and on every relevant Settings change.
    function apply() {
        const c = hyprFor(Themes.find(Settings.theme))
        Quickshell.execDetached(["sh", "-c", "cat > '" + path + "' <<'PILO_EOF'\n" + buildLua(c) + "PILO_EOF"])
        applyProc.command = ["sh", "-c", liveScript(c)]
        applyProc.running = true
    }

    function liveScript(c) {
        // One eval applies the whole set. The Lua has no single quotes, so
        // wrapping it in single quotes for the shell is unambiguous.
        return "hyprctl eval 'hl.config({ "
            + "general = { gaps_in = " + Settings.hyprGapsIn
            + ", gaps_out = " + Settings.hyprGapsOut
            + ", border_size = " + Settings.hyprBorderSize
            + ", col = { active_border = { colors = { \"" + c.active[0] + "\", \"" + c.active[1] + "\" }, angle = " + activeAngle + " }, "
            + "inactive_border = \"" + c.inactive + "\" } }, "
            + "decoration = { rounding = " + Settings.hyprRounding
            + ", blur = { enabled = " + luaBool(Settings.hyprBlurEnabled) + ", size = " + Settings.hyprBlurSize + " } }, "
            + "misc = { background_color = " + c.background + " } })'"
    }

    function buildLua(c) {
        let s = ""
        s += "-- Hyprland look and feel, generated by the pilo settings app (Theming).\n"
        s += "-- hyprland.lua loads this with require(). It is rewritten when a look-and-feel\n"
        s += "-- setting changes or the shell starts, so edit it in the settings app.\n"
        s += "return {\n"
        s += "    general = {\n"
        s += "        gaps_in     = " + Settings.hyprGapsIn + ",\n"
        s += "        gaps_out    = " + Settings.hyprGapsOut + ",\n"
        s += "        border_size = " + Settings.hyprBorderSize + ",\n"
        s += "        col = {\n"
        s += "            active_border   = { colors = { \"" + c.active[0] + "\", \"" + c.active[1] + "\" }, angle = " + activeAngle + " },\n"
        s += "            inactive_border = \"" + c.inactive + "\",\n"
        s += "        },\n"
        s += "        resize_on_border = false,\n"
        s += "        allow_tearing    = false,\n"
        s += "        layout           = \"dwindle\",\n"
        s += "    },\n"
        s += "    decoration = {\n"
        s += "        rounding       = " + Settings.hyprRounding + ",\n"
        s += "        rounding_power = 2,\n"
        s += "        active_opacity   = 1.0,\n"
        s += "        inactive_opacity = 1.0,\n"
        s += "        shadow = { enabled = true, range = 4, render_power = 3, color = 0xee1a1a1a },\n"
        s += "        blur = {\n"
        s += "            enabled  = " + luaBool(Settings.hyprBlurEnabled) + ",\n"
        s += "            size     = " + Settings.hyprBlurSize + ",\n"
        s += "            passes   = 2,\n"
        s += "            vibrancy = 0.1696,\n"
        s += "            -- 0.56 defaults ignore_opacity to true, which kills window blur on\n"
        s += "            -- this setup; force it off.\n"
        s += "            ignore_opacity = false,\n"
        s += "        },\n"
        s += "    },\n"
        s += "    animations = { enabled = true },\n"
        s += "    animation_list = {\n"
        s += "        { leaf = \"windows\",    enabled = true, speed = 4.79, bezier = \"default\" },\n"
        s += "        { leaf = \"fade\",       enabled = true, speed = 3.03, bezier = \"default\" },\n"
        s += "        { leaf = \"workspaces\", enabled = true, speed = 1.94, bezier = \"default\", style = \"fade\" },\n"
        s += "        -- Layer surfaces (bar, notifications, wallpaper, ...) fade on their own;\n"
        s += "        -- this is what makes the wallpaper crossfade animate.\n"
        s += "        { leaf = \"fadeLayers\", enabled = true, speed = 60,   bezier = \"default\" },\n"
        s += "    },\n"
        s += "    background_color = " + c.background + ",\n"
        s += "}\n"
        return s
    }

    // Re-apply when the theme or any look-and-feel value changes.
    Connections {
        target: Settings
        function onThemeChanged() { root.apply() }
        function onHyprGapsInChanged() { root.apply() }
        function onHyprGapsOutChanged() { root.apply() }
        function onHyprBorderSizeChanged() { root.apply() }
        function onHyprRoundingChanged() { root.apply() }
        function onHyprBlurEnabledChanged() { root.apply() }
        function onHyprBlurSizeChanged() { root.apply() }
    }

    Process {
        id: applyProc
        // command assigned per apply()
    }
}
