pragma Singleton

import Quickshell
import Quickshell.Io
import QtQuick

// Styles KDE apps (Dolphin and friends) to match the active theme. Dolphin runs
// under KDE's platform theme (QT_QPA_PLATFORMTHEME=kde) and takes its colours
// from ~/.config/kdeglobals, so this generates a KDE colour scheme under
// ~/.local/share/color-schemes/ and applies it with plasma-apply-colorscheme,
// which copies the colours into kdeglobals, updates the scheme hash, and notifies
// the session so running apps reload.
//
// KDE needs far more colour roles than the bar's ~10 tokens, so the shade() and
// group() helpers derive window/view/button/selection/tooltip backgrounds and
// the foreground roles from the palette.
Singleton {
    id: root

    readonly property string schemeDir: String(Quickshell.env("HOME")) + "/.local/share/color-schemes"

    function apply() {
        const theme = Themes.find(Settings.theme)
        const name = "Pilo-" + theme.id
        const file = schemeDir + "/" + name + ".colors"
        // Write the scheme and apply it in one shell command so the tool never
        // runs before the file exists. plasma-apply-colorscheme is part of
        // Plasma; if it is missing the write is harmless and kdeglobals is left
        // alone.
        const script = "mkdir -p '" + schemeDir + "' && "
            + "cat > '" + file + "' <<'PILO_EOF'\n" + buildScheme(theme, name) + "PILO_EOF\n"
            + "plasma-apply-colorscheme '" + name + "'"
        applyProc.command = ["sh", "-c", script]
        applyProc.running = true
    }

    function parse(hex) {
        const h = hex.charAt(0) === "#" ? hex.substring(1) : hex
        return {
            r: parseInt(h.substring(0, 2), 16),
            g: parseInt(h.substring(2, 4), 16),
            b: parseInt(h.substring(4, 6), 16)
        }
    }

    // amount > 0 lightens toward white, < 0 darkens toward black.
    function shade(c, amount) {
        const a = parse(c)
        if (amount >= 0)
            return { r: Math.round(a.r + (255 - a.r) * amount), g: Math.round(a.g + (255 - a.g) * amount), b: Math.round(a.b + (255 - a.b) * amount) }
        const f = 1 + amount
        return { r: Math.round(a.r * f), g: Math.round(a.g * f), b: Math.round(a.b * f) }
    }

    // Accepts a "#rrggbb" string or a {r,g,b} object from shade().
    function rgb(c) {
        const v = typeof c === "string" ? parse(c) : c
        return v.r + "," + v.g + "," + v.b
    }

    function group(bg, alt, fg, inactive, theme) {
        let s = ""
        s += "BackgroundAlternate=" + rgb(alt) + "\n"
        s += "BackgroundNormal=" + rgb(bg) + "\n"
        s += "DecorationFocus=" + rgb(theme.teal) + "\n"
        s += "DecorationHover=" + rgb(theme.steel) + "\n"
        s += "ForegroundActive=" + rgb(theme.teal) + "\n"
        s += "ForegroundInactive=" + rgb(inactive) + "\n"
        s += "ForegroundLink=" + rgb(theme.steel) + "\n"
        s += "ForegroundNegative=" + rgb(theme.error) + "\n"
        s += "ForegroundNeutral=" + rgb(theme.warning) + "\n"
        s += "ForegroundNormal=" + rgb(fg) + "\n"
        s += "ForegroundPositive=" + rgb(theme.plus) + "\n"
        s += "ForegroundVisited=" + rgb(theme.steel) + "\n"
        return s
    }

    function buildScheme(theme, name) {
        const bg = theme.bg
        const fg = theme.fg
        const muted = theme.muted
        const view = shade(bg, -0.18)
        const viewAlt = shade(bg, -0.08)
        const windowAlt = shade(bg, 0.08)
        const button = shade(bg, 0.10)
        const buttonAlt = shade(bg, 0.18)
        const tooltip = shade(bg, 0.16)
        const compl = shade(bg, -0.10)
        const header = shade(bg, 0.12)

        let s = ""
        s += "# Generated by the pilo bar (Theming). Do not edit; pick a theme there.\n\n"

        s += "[ColorEffects:Disabled]\n"
        s += "Color=56,56,56\nColorAmount=0\nColorEffect=0\nContrastAmount=0.65\nContrastEffect=1\nIntensityAmount=0.1\nIntensityEffect=2\n\n"

        s += "[ColorEffects:Inactive]\n"
        s += "ChangeSelectionColor=true\nColor=112,111,110\nColorAmount=0.025\nColorEffect=2\nContrastAmount=0.1\nContrastEffect=2\nEnable=false\nIntensityAmount=0\nIntensityEffect=0\n\n"

        s += "[Colors:Button]\n" + group(button, buttonAlt, fg, muted, theme) + "\n"
        s += "[Colors:Complementary]\n" + group(compl, windowAlt, fg, muted, theme) + "\n"
        s += "[Colors:Header]\n" + group(header, button, fg, muted, theme) + "\n"
        s += "[Colors:Header][Inactive]\n" + group(button, header, fg, muted, theme) + "\n"
        s += "[Colors:Selection]\n" + group(theme.teal, theme.teal, bg, bg, theme) + "\n"
        s += "[Colors:Tooltip]\n" + group(tooltip, tooltip, fg, muted, theme) + "\n"
        s += "[Colors:View]\n" + group(view, viewAlt, fg, muted, theme) + "\n"
        s += "[Colors:Window]\n" + group(bg, windowAlt, fg, muted, theme) + "\n"

        s += "[General]\n"
        s += "ColorScheme=" + name + "\n"
        s += "Name=Pilo " + theme.name + "\n"
        s += "shadeSortColumn=true\n\n"

        s += "[KDE]\ncontrast=4\n\n"

        s += "[WM]\n"
        s += "activeBackground=" + rgb(bg) + "\n"
        s += "activeBlend=" + rgb(fg) + "\n"
        s += "activeForeground=" + rgb(fg) + "\n"
        s += "inactiveBackground=" + rgb(shade(bg, -0.1)) + "\n"
        s += "inactiveBlend=" + rgb(muted) + "\n"
        s += "inactiveForeground=" + rgb(muted) + "\n"
        return s
    }

    Connections {
        target: Settings
        function onThemeChanged() { root.apply() }
    }

    Process {
        id: applyProc
    }
}
